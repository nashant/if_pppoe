# Per-checkout lab host settings. Copy this file to lab/local.env (gitignored)
# and fill in real values, or export the same variables in your shell instead.
# Sourced by both `make -C lab` (Makefile syntax) and lab/vm/common.sh (bash
# syntax) -- keep it to plain KEY=VALUE lines with no spaces around `=` and
# no shell expansion, so both readers agree on it.

# SSH-reachable host that runs the lab's VMs (lab/vm/*.sh, `make -C lab
# lab-up`/`test-func`/etc.). Needs KVM and enough RAM/disk for the client,
# isp and mpdsrv VMs; see lab/vm/README.md for sizing.
VMHOST=labhost.example

# Hosts used by `make -C lab perf-matrix` (tests/perf/run_matrix.py):
# the PPPoE server VM, the client VM, and the DUT running if_pppoe/mpd5.
PERF_SERVER=labhost.example
PERF_CLIENT=labhost.example
PERF_DUT=labhost.example
