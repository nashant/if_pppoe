# plugin/build/ is tracked source (packaging scripts), not a build output
# dir -- the generic build/ rule above would otherwise silently swallow it
# on a plain `g add .` (git skips already-ignored paths without erroring).
!/plugin/build/
# Actual build output/work dirs under plugin/, e.g. plugin/*/work/.
/plugin/*/work/
/plugin/*/*/work/
# build-all.sh's own work dir (kernel overlays, private pkg db, repo).
/plugin/build/work-all/

# pkg-build.sh's local fetch destination (default and any --local-out).
/lab/vm/pkg-build-out/

# CI (docs/CI.md)
/out/
/.ci-cache/
/.ci-images/
/.ci-secrets/

# Local agent tooling (not product; per-checkout only)
/.agents/
/.claude/

# Lab host settings local to a checkout -- see lab/local.env.example
/lab/local.env
